# Required — from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs that unlock /stats /block /unblock /grant
ADMIN_IDS=

# Empty = long polling (default). Set to https://your.domain to use webhooks.
WEBHOOK_BASE=
WEBHOOK_SECRET=
WEBHOOK_PORT=8080

# Tesseract language codes, `+` separated. Users can override with /lang.
DEFAULT_LANGS=eng
DEFAULT_ENGINE=tesseract
OCR_CONCURRENCY=4
OCR_TIMEOUT_S=60
TESSERACT_CMD=tesseract
MAX_PDF_PAGES=20

# Optional premium engine. Leave blank to disable it entirely — no cost, no
# calls made. Set a real key to let users opt into /engine vision.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

FREE_DAILY_PAGES=30
PREMIUM_DAILY_PAGES=300
BURST_PER_MINUTE=12

# Set false to store no extracted text at all (disables /search).
STORE_TEXT_HISTORY=true
HISTORY_RETENTION_DAYS=30

# Hard Bot API limit; raise only with a local Bot API server.
MAX_FILE_MB=20

LOG_JSON=false
